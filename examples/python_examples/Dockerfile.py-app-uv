# syntax=docker/dockerfile:1

# The builder uses Debian 13's own python3, the same interpreter and ABI as the
# distroless runtime, so native wheels such as pandas load there unchanged.
FROM debian:13 AS build
# Unpinned on purpose: a no-cache rebuild picks up upstream fixes.
# hadolint ignore=DL3008
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/bin/python3 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app
COPY py_src/pyproject.toml py_src/uv.lock ./
RUN uv sync --frozen --no-dev

# CI builds the base from this repo and substitutes it for this reference.
# Production images should follow a floating tag or pin @sha256, see README.
FROM ghcr.io/fivexl/secure-container-image-base-python3:python3.13-debian13
COPY --from=build /app/.venv /app/.venv
COPY py_src/main.py /app/main.py
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s \
  CMD ["lprobe", "-mode=http", "-endpoint=/", "-port=8080"]
ENTRYPOINT ["/app/.venv/bin/python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]

# docker build -t py-app-uv -f Dockerfile.py-app-uv .
# docker run --read-only --cap-drop=ALL --security-opt=no-new-privileges -p 8080:8080 py-app-uv
# curl http://localhost:8080/stats
