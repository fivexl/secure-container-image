# syntax=docker/dockerfile:1

FROM golang:1.27-trixie AS build
WORKDIR /src
COPY gosrc/ ./
# Static binary: the runtime base has no libc.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/app .

# CI builds the base from this repo and substitutes it for this reference.
# Production images should follow a floating tag or pin @sha256, see README.
FROM ghcr.io/fivexl/secure-container-image-base:debian13
USER 65532:65532
COPY --from=build /out/app /app/app
EXPOSE 8080
ENTRYPOINT ["/app/app"]
HEALTHCHECK --interval=30s --timeout=3s \
  CMD ["lprobe", "-mode=http", "-endpoint=/", "-port=8080"]

# docker build -t goapp -f Dockerfile.goapp .
# docker run --read-only --cap-drop=ALL --security-opt=no-new-privileges -p 8080:8080 goapp
