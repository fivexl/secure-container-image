# syntax=docker/dockerfile:1

FROM node:26-trixie AS build
WORKDIR /deps
COPY src/package.json src/package-lock.json ./
RUN npm ci --omit=dev

# CI builds the base from this repo and substitutes it for this reference.
# Production images should follow a floating tag or pin @sha256, see README.
# hadolint ignore=DL3007
FROM ghcr.io/fivexl/secure-container-image-base-nodejs:latest
COPY --from=build /deps/node_modules /app/node_modules
COPY src/app/ /app/
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s \
  CMD ["lprobe", "-mode=http", "-endpoint=/", "-port=8080"]
# The base ENTRYPOINT is dumb-init -- node.
CMD ["server.js"]

# docker build -t node-app -f Dockerfile.node-app .
# docker run --read-only --cap-drop=ALL --security-opt=no-new-privileges -p 8080:8080 node-app
# curl http://localhost:8080/stats
